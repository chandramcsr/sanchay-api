# Copy to .env for local development. Never commit the real .env.

# Local Postgres via docker-compose (see docker-compose.yml):
DATABASE_URL=postgresql://sanchay:sanchay_dev_password@localhost:5432/sanchay

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173,https://chandramcsr.github.io

# Optional. Error tracking (Sentry). Leave unset for local dev — the
# SDK is a documented no-op with no DSN, not an error.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# Optional. APM tracing (Datadog), via ddtrace-run wrapping uvicorn in
# the Dockerfile. Read directly by ddtrace itself, not by this app's
# config — leave unset for local dev, ddtrace-run degrades to a no-op
# (traces are generated but silently dropped, not an error) when it
# can't reach an agent at DD_AGENT_HOST. DD_AGENT_HOST is the Render
# private-service hostname of the Datadog Agent template
# (github.com/render-examples/datadog-agent), not a public URL.
# DD_AGENT_HOST=datadog-agent-xxxx
# DD_TRACE_AGENT_PORT=8126
# DD_SERVICE=sanchay-api
# DD_ENV=production

# Copy to .env for local development. Never commit the real .env.

# Local Postgres via docker-compose (see docker-compose.yml):
DATABASE_URL=postgresql://sanchay:sanchay_dev_password@localhost:5432/sanchay

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173,https://chandramcsr.github.io

# Optional. Error tracking (Sentry). Leave unset for local dev — the
# SDK is a documented no-op with no DSN, not an error.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# Optional. APM tracing (Datadog). trace-agent runs as a second
# process inside this same container (see start.sh + Dockerfile) --
# no separate Render private service, so DD_AGENT_HOST isn't needed;
# ddtrace's default (localhost:8126) already finds it. Leave
# DD_API_KEY unset for local dev -- trace-agent still starts, it just
# has nothing to forward to, same no-op-until-configured pattern as
# everything else optional here.
# DD_API_KEY=
# DD_SITE=datadoghq.com
# DD_SERVICE=sanchay-api
# DD_ENV=production
